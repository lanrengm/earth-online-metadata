---
import AppNav from '../components/AppNav.astro';
import ToolSidebar from '../components/ToolSidebar.astro';
import Footer from '../components/Footer.astro';
import iconFontUrl from '../styles/fonts/material-symbols-rounded.subset.woff2?url';
import '../styles/tokens.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = '人生面板（Earth Online）——全本地运行的个人成长与记账工具，附知识博客与在线工具。' } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const current = base && Astro.url.pathname.startsWith(base)
  ? Astro.url.pathname.slice(base.length)
  : Astro.url.pathname;
---
<!doctype html>
<html lang="zh">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} · Earth Online</title>
    <meta name="description" content={description} />
    <!-- 图标字体自托管子集（52 图标，75KB），preload 消除图标闪烁 -->
    <link rel="preload" href={iconFontUrl} as="font" type="font/woff2" crossorigin />
    <!-- 首屏前设置主题，避免闪烁（FOUC）；亮/暗/跟随系统，与 app es_theme 对齐 -->
    <script is:inline>
      (function () {
        const m = localStorage.getItem('eo_theme');
        const dark = m === 'dark' || (m !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
        if (
          localStorage.getItem('eo_sidebar') === '1'
          && matchMedia('(min-width: 1024px)').matches
        ) {
          document.documentElement.setAttribute('data-sidebar', 'open');
        }
      })();
    </script>
  </head>
  <body>
    <div class="app-shell">
      <ToolSidebar current={current} />
      <div class="app-col">
        <AppNav current={current} />
        <main class="app-main">
          <slot />
        </main>
        <Footer />
      </div>
    </div>
  </body>
</html>
