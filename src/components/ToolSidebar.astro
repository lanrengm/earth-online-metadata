---
import { getCollection } from 'astro:content';
import { tools } from '../tools/registry.js';
import { tests } from '../tests/registry.js';
import { withBase } from '../lib/paths.js';

interface Props {
  current: string;
}

const { current } = Astro.props;

const isArticlesArea = current.startsWith('/articles');
const isTestsArea = current.startsWith('/tests');
const isToolsArea = current.startsWith('/tools');

/* 一级导航（决策 #17 修订四/五：主页/攻略/辅助工具/天赋检测，单列动线全站唯一高亮源） */
const areas = [
  { href: '/', label: '主页', icon: 'home', active: current === '/' },
  { href: '/articles/', label: '攻略', icon: 'article', active: isArticlesArea },
  { href: '/tools/', label: '辅助工具', icon: 'widgets', active: isToolsArea },
  { href: '/tests/', label: '天赋检测', icon: 'psychology', active: isTestsArea },
];

const groups = new Map<string, typeof tools>();
for (const t of tools) {
  const key = t.category || '其他';
  const list = groups.get(key);
  if (list) list.push(t);
  else groups.set(key, [t]);
}

/* 天赋检测按认知领域分组（决策 #17 修订七：category 字段，注册表顺序即展示顺序） */
const testGroups = new Map<string, typeof tests>();
for (const t of tests) {
  const key = t.category || '其他';
  const list = testGroups.get(key);
  if (list) list.push(t);
  else testGroups.set(key, [t]);
}

const articles = isArticlesArea
  ? (await getCollection('articles')).sort(
      (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
    )
  : [];
---

<div class="sidebar-scrim" id="sidebar-scrim" aria-hidden="true"></div>
<aside class="tool-sidebar" id="tool-sidebar" aria-label="侧边导航">
  <div class="ts-inner">
    <a href={withBase('/tools/')} class="ts-brand">
      <span class="ts-brand-sub">EARTH ONLINE</span>
      <span class="ts-brand-name">17 号玩家</span>
      <span class="ts-brand-meta"><span class="ts-brand-dot"></span>PLAYER · 17</span>
    </a>

    <div class="ts-scroll">
    <nav class="ts-areas" aria-label="一级导航">
      {areas.map((a) => (
        <a
          href={withBase(a.href)}
          class:list={['ts-area', { active: a.active }]}
          aria-current={a.active ? 'page' : undefined}
        >
          <span class="mi" aria-hidden="true">{a.icon}</span>
          {a.label}
        </a>
      ))}
    </nav>

    {isTestsArea ? (
      <nav class="ts-nav">
        {[...testGroups.entries()].map(([cat, list]) => (
          <div class="ts-group" data-group={cat}>
            <button class="ts-group-toggle" type="button" aria-expanded="true">
              <span class="mi ts-chev" aria-hidden="true">expand_more</span>
              {cat}
            </button>
            {list.map((t) => {
              const href = `/tests/${t.slug}/`;
              const active = current === href;
              return (
                <a
                  href={withBase(href)}
                  class:list={['ts-item', { active }]}
                  aria-current={active ? 'page' : undefined}
                >
                  {t.icon && <span class="mi" aria-hidden="true">{t.icon}</span>}
                  {t.title}
                </a>
              );
            })}
          </div>
        ))}
      </nav>
    ) : isArticlesArea ? (
      <nav class="ts-nav">
        <div class="ts-group">
          <div class="ts-group-title">最新文章</div>
          {articles.map((a) => {
            const href = `/articles/${a.id}/`;
            const active = current === href;
            return (
              <a
                href={withBase(href)}
                class:list={['ts-item ts-article', { active }]}
                aria-current={active ? 'page' : undefined}
              >
                <span class="ts-article-text">{a.data.title}</span>
                <span class="ts-article-date">
                  {a.data.date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'short' })}
                </span>
              </a>
            );
          })}
        </div>
      </nav>
    ) : (
      <nav class="ts-nav">
        {[...groups.entries()].map(([name, list]) => (
          <div class="ts-group">
            <div class="ts-group-title">{name}</div>
            {list.map((t) => {
              const href = `/tools/${t.slug}/`;
              const active = current === href;
              return (
                <a
                  href={withBase(href)}
                  class:list={['ts-item', { active }]}
                  aria-current={active ? 'page' : undefined}
                >
                  {t.icon && <span class="mi" aria-hidden="true">{t.icon}</span>}
                  {t.title}
                </a>
              );
            })}
          </div>
        ))}
      </nav>
    )}

    <footer class="ts-footer">
      <p>© 2026 17 号玩家 · 零隐私收集</p>
      <nav>
        <a href={withBase('/privacy/')}>隐私政策</a>
        <a href={withBase('/terms/')}>用户协议</a>
      </nav>
    </footer>
    </div>
  </div>
</aside>

<style>
  /* 桌面：侧栏是 flex 两栏中的 in-flow 列，物理上不可能遮盖右栏 AppBar；
     宽度 0 ⇄ 280 过渡，右栏 flex:1 自动重排（见 tokens.css .app-shell） */
  .sidebar-scrim {
    display: none;
    position: fixed; top: 56px; left: 0; right: 0; bottom: 0;
    background: rgba(0, 0, 0, .45);
    z-index: 15;
  }

  .tool-sidebar {
    flex-shrink: 0;
    width: 0;
    overflow: hidden;
    visibility: hidden;
    transition: width .2s ease, visibility .2s ease;
  }
  :global(html[data-sidebar='open']) .tool-sidebar {
    width: 280px;
    visibility: visible;
  }

  .ts-inner {
    width: 280px; height: 100%;
    display: flex; flex-direction: column;
    background: var(--surface-container-low);
    overflow-y: auto; /* 全侧栏整体滚动（决策 #17 修订七：品牌块不固定） */
  }

  /* 玩家名牌（决策 #17 修订二/五：HUD 面板，全主题统一） */
  .ts-brand {
    flex-shrink: 0;
    display: flex; flex-direction: column; gap: 4px;
    padding: 26px 22px 22px;
    background: transparent;
    color: var(--on-surface);
    border-bottom: 1px solid var(--outline-variant);
    border-left: 2px solid var(--primary);
    position: relative;
  }
  .ts-brand:hover { text-decoration: none; }
  .ts-brand::after {
    content: '';
    position: absolute; top: 8px; right: 8px;
    width: 9px; height: 9px;
    border-top: 2px solid var(--primary);
    border-right: 2px solid var(--primary);
    opacity: .85;
  }
  .ts-brand-sub {
    display: block;
    font-family: var(--font-mono); font-size: 10px; letter-spacing: 2.5px;
    color: var(--primary);
  }
  .ts-brand-name { font-family: var(--font-title); font-size: 22px; font-weight: 800; letter-spacing: 3px; } /* 科幻风：宽字距名牌 */
  .ts-brand-meta {
    display: flex; align-items: center; gap: 6px; margin-top: 8px;
    font-family: var(--font-mono); font-size: 10px; letter-spacing: 1.5px;
    color: var(--on-surface-variant);
  }
  .ts-brand-dot {
    display: inline-block;
    width: 6px; height: 6px; border-radius: 999px;
    background: var(--primary);
    box-shadow: 0 0 6px var(--primary);
  }

  /* 一级导航（决策 #17 修订四/五）：品牌块下方的四区切换，区内选中用品牌色 + accent 线 */
  .ts-areas { display: flex; flex-direction: column; gap: 2px; padding: 12px 10px; border-bottom: 1px solid var(--outline-variant); }
  .ts-area {
    display: flex; align-items: center; gap: 12px;
    padding: 10px 14px; border-radius: var(--radius-lg);
    color: var(--on-surface-variant);
    font-size: 14px; font-weight: 600;
  }
  .ts-area .mi { font-size: 20px; flex-shrink: 0; }
  .ts-area:hover { text-decoration: none; color: var(--primary); }
  .ts-area.active {
    background: var(--surface-container-high);
    color: var(--primary);
    box-shadow: inset 2px 0 0 var(--primary);
  }

  /* 滚动结构（决策 #17 修订七）：品牌块随内容一起滚动 */
  .ts-scroll {
    display: flex; flex-direction: column;
  }

  .ts-nav { padding: 12px 10px 16px; display: flex; flex-direction: column; gap: 4px; }
  .ts-item {
    display: flex; align-items: center; gap: 12px;
    padding: 10px 14px; border-radius: var(--radius-lg);
    color: var(--on-surface-variant);
    font-size: 14px; font-weight: 500;
  }
  .ts-item:hover { text-decoration: none; color: var(--primary); }
  .ts-item .mi { font-size: 20px; flex-shrink: 0; }
  .ts-item.active {
    background: var(--surface-container-high);
    color: var(--on-surface); font-weight: 600;
    box-shadow: inset 2px 0 0 var(--primary); /* 科幻风：左侧主色 accent 线（决策 #17） */
  }

  .ts-group { display: flex; flex-direction: column; gap: 2px; margin-top: 8px; }
  .ts-group-title {
    padding: 14px 14px 6px;
    font-size: 12px; font-weight: 600;
    color: var(--on-surface-variant);
    letter-spacing: .5px;
  }

  /* 分组折叠（it-tools 式，决策 #17 修订七）：仅天赋检测区；默认展开，状态存 localStorage */
  .ts-group-toggle {
    display: flex; align-items: center; gap: 4px;
    width: 100%; padding: 14px 10px 6px;
    border: none; background: transparent; cursor: pointer;
    font-size: 12px; font-weight: 600; letter-spacing: .5px;
    color: var(--on-surface-variant); font-family: var(--font-body);
    text-align: left;
  }
  .ts-chev { font-size: 16px; transition: transform .15s ease; }
  .ts-group.collapsed .ts-chev { transform: rotate(-90deg); }
  .ts-group.collapsed .ts-item { display: none; }

  /* 文章条目：标题可两行 + 日期小字 */
  .ts-article { align-items: flex-start; flex-direction: column; gap: 3px; }
  .ts-article-text { font-size: 14px; line-height: 1.4; }
  .ts-article-date { font-family: var(--font-mono); font-size: 12px; color: var(--on-surface-variant); font-weight: 400; }

  /* 侧栏底部版权：常驻不随导航滚走；与侧栏同底色，分割线区分边界（决策 #17 修订五） */
  .ts-footer {
    flex-shrink: 0;
    padding: 14px 18px 18px;
    background: transparent;
    border-top: 1px solid var(--outline-variant);
    color: var(--on-surface-variant);
    font-size: 12px;
  }
  .ts-footer p { line-height: 1.6; margin-bottom: 8px; }
  .ts-footer nav { display: flex; gap: 16px; }
  .ts-footer a { color: var(--on-surface-variant); }

  /* 窄屏：退化为从 AppBar 下沿滑出的抽屉，遮罩同高，绝不遮盖 AppBar */
  @media (max-width: 1023px) {
    .tool-sidebar {
      position: fixed; top: 56px; bottom: 0; left: 0; z-index: 20;
      width: 280px;
      visibility: visible;
      transform: translateX(-100%);
      transition: transform .2s ease;
    }
    :global(html[data-sidebar='open']) .tool-sidebar {
      transform: translateX(0);
    }
    :global(html[data-sidebar='open']) .sidebar-scrim { display: block; }
  }
</style>

<script>
  const KEY = 'eo_sidebar';
  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>('#sidebar-toggle');
  const scrim = document.querySelector<HTMLElement>('#sidebar-scrim');
  const sidebar = document.querySelector<HTMLElement>('#tool-sidebar');

  const isOpen = () => root.getAttribute('data-sidebar') === 'open';
  const setOpen = (open: boolean) => {
    root.setAttribute('data-sidebar', open ? 'open' : 'closed');
    localStorage.setItem(KEY, open ? '1' : '0');
    toggle?.setAttribute('aria-expanded', String(open));
    // 手机抽屉打开时自动定位到选中项，免去用户滑动查找（决策 #17 修订七）
    if (open && matchMedia('(max-width: 1023px)').matches) {
      requestAnimationFrame(() => {
        sidebar
          ?.querySelector('.ts-item.active, .ts-area.active')
          ?.scrollIntoView({ block: 'center' });
      });
    }
  };

  toggle?.setAttribute('aria-expanded', String(isOpen()));
  toggle?.addEventListener('click', () => setOpen(!isOpen()));
  scrim?.addEventListener('click', () => setOpen(false));
  sidebar?.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', () => {
      if (matchMedia('(max-width: 1023px)').matches) setOpen(false);
    });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen() && !(e.target instanceof HTMLInputElement)) setOpen(false);
  });

  // 天赋检测分组折叠（决策 #17 修订七）：默认展开，折叠状态存 localStorage
  const KEY_GROUPS = 'eo_tests_groups';
  const groupEls = document.querySelectorAll<HTMLElement>('.ts-group[data-group]');
  if (groupEls.length) {
    let collapsed: string[] = [];
    try { collapsed = JSON.parse(localStorage.getItem(KEY_GROUPS) ?? '[]'); } catch { /* 忽略坏数据 */ }
    groupEls.forEach((g) => {
      const name = g.getAttribute('data-group') ?? '';
      const btn = g.querySelector<HTMLButtonElement>('.ts-group-toggle');
      const apply = (isCollapsed: boolean) => {
        g.classList.toggle('collapsed', isCollapsed);
        btn?.setAttribute('aria-expanded', String(!isCollapsed));
      };
      apply(collapsed.includes(name));
      btn?.addEventListener('click', () => {
        const now = g.classList.toggle('collapsed');
        apply(now);
        try {
          const set = new Set<string>(JSON.parse(localStorage.getItem(KEY_GROUPS) ?? '[]'));
          if (now) set.add(name); else set.delete(name);
          localStorage.setItem(KEY_GROUPS, JSON.stringify([...set]));
        } catch { /* 写失败不阻塞交互 */ }
      });
    });
  }
</script>
