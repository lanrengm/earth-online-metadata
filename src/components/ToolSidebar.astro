---
import { getCollection } from 'astro:content';
import { tools } from '../tools/registry.js';
import { withBase } from '../lib/paths.js';

interface Props {
  current: string;
}

const { current } = Astro.props;

const isArticlesArea = current.startsWith('/articles');
const isToolsHome = current === '/tools/' || current === '/tools';
const isArticlesHome = current === '/articles/' || current === '/articles';

const groups = new Map<string, typeof tools>();
for (const t of tools) {
  const key = t.category || '其他';
  const list = groups.get(key);
  if (list) list.push(t);
  else groups.set(key, [t]);
}

const articles = isArticlesArea
  ? (await getCollection('articles')).sort(
      (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
    )
  : [];
---

<div class="sidebar-scrim" id="sidebar-scrim" aria-hidden="true"></div>
<aside class="tool-sidebar" id="tool-sidebar" aria-label="侧边导航">
  <div class="ts-inner">
    <a href={withBase('/tools/')} class="ts-brand">
      <span class="ts-brand-name">Earth Online</span>
      <span class="ts-brand-sub">人生面板 · 在线工具</span>
    </a>

    {isArticlesArea ? (
      <nav class="ts-nav">
        <a
          href={withBase('/articles/')}
          class:list={['ts-item', { active: isArticlesHome }]}
          aria-current={isArticlesHome ? 'page' : undefined}
        >
          <span class="mi" aria-hidden="true">article</span>
          全部文章
        </a>
        <div class="ts-group">
          <div class="ts-group-title">最新文章</div>
          {articles.map((a) => {
            const href = `/articles/${a.id}/`;
            const active = current === href;
            return (
              <a
                href={withBase(href)}
                class:list={['ts-item ts-article', { active }]}
                aria-current={active ? 'page' : undefined}
              >
                <span class="ts-article-text">{a.data.title}</span>
                <span class="ts-article-date">
                  {a.data.date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'short' })}
                </span>
              </a>
            );
          })}
        </div>
      </nav>
    ) : (
      <nav class="ts-nav">
        <a
          href={withBase('/tools/')}
          class:list={['ts-item', { active: isToolsHome }]}
          aria-current={isToolsHome ? 'page' : undefined}
        >
          <span class="mi" aria-hidden="true">home</span>
          全部工具
        </a>

        {[...groups.entries()].map(([name, list]) => (
          <div class="ts-group">
            <div class="ts-group-title">{name}</div>
            {list.map((t) => {
              const href = `/tools/${t.slug}/`;
              const active = current === href;
              return (
                <a
                  href={withBase(href)}
                  class:list={['ts-item', { active }]}
                  aria-current={active ? 'page' : undefined}
                >
                  {t.icon && <span class="mi" aria-hidden="true">{t.icon}</span>}
                  {t.title}
                </a>
              );
            })}
          </div>
        ))}
      </nav>
    )}

    <footer class="ts-footer">
      <p>© 2026 Earth Online（人生面板）· 全本地运行，零隐私收集</p>
      <nav>
        <a href={withBase('/privacy/')}>隐私政策</a>
        <a href={withBase('/terms/')}>用户协议</a>
      </nav>
    </footer>
  </div>
</aside>

<style>
  /* 桌面：侧栏是 flex 两栏中的 in-flow 列，物理上不可能遮盖右栏 AppBar；
     宽度 0 ⇄ 280 过渡，右栏 flex:1 自动重排（见 tokens.css .app-shell） */
  .sidebar-scrim {
    display: none;
    position: fixed; top: 56px; left: 0; right: 0; bottom: 0;
    background: rgba(0, 0, 0, .45);
    z-index: 15;
  }

  .tool-sidebar {
    flex-shrink: 0;
    width: 0;
    overflow: hidden;
    visibility: hidden;
    transition: width .2s ease, visibility .2s ease;
  }
  :global(html[data-sidebar='open']) .tool-sidebar {
    width: 280px;
    visibility: visible;
  }

  .ts-inner {
    width: 280px; height: 100%;
    display: flex; flex-direction: column;
    background: var(--surface-container-low);
  }

  /* 品牌色块（fnos：纯色阶，无描边无渐变） */
  .ts-brand {
    flex-shrink: 0;
    display: flex; flex-direction: column; gap: 4px;
    padding: 26px 22px 22px;
    background: var(--primary);
    color: var(--on-primary);
  }
  .ts-brand:hover { text-decoration: none; }
  .ts-brand-name { font-family: var(--font-title); font-size: 22px; font-weight: 800; letter-spacing: .5px; }
  .ts-brand-sub { font-size: 12.5px; opacity: .85; }

  .ts-nav { flex: 1; overflow-y: auto; padding: 12px 10px 16px; display: flex; flex-direction: column; gap: 4px; }
  .ts-item {
    display: flex; align-items: center; gap: 12px;
    padding: 10px 14px; border-radius: var(--radius-lg);
    color: var(--on-surface-variant);
    font-size: 14px; font-weight: 500;
  }
  .ts-item:hover { text-decoration: none; color: var(--primary); }
  .ts-item .mi { font-size: 20px; flex-shrink: 0; }
  .ts-item.active {
    background: var(--surface-container-high);
    color: var(--on-surface); font-weight: 600;
  }

  .ts-group { display: flex; flex-direction: column; gap: 2px; margin-top: 8px; }
  .ts-group-title {
    padding: 14px 14px 6px;
    font-size: 12px; font-weight: 600;
    color: var(--on-surface-variant);
    letter-spacing: .5px;
  }

  /* 文章条目：标题可两行 + 日期小字 */
  .ts-article { align-items: flex-start; flex-direction: column; gap: 3px; }
  .ts-article-text { font-size: 14px; line-height: 1.4; }
  .ts-article-date { font-size: 12px; color: var(--on-surface-variant); font-weight: 400; }

  /* 侧栏底部版权：常驻不随导航滚走；fnos 色阶分隔（surface 对 container-low），不用边线 */
  .ts-footer {
    flex-shrink: 0;
    padding: 14px 18px 18px;
    background: var(--surface);
    color: var(--on-surface-variant);
    font-size: 12px;
  }
  .ts-footer p { line-height: 1.6; margin-bottom: 8px; }
  .ts-footer nav { display: flex; gap: 16px; }
  .ts-footer a { color: var(--on-surface-variant); }

  /* 窄屏：退化为从 AppBar 下沿滑出的抽屉，遮罩同高，绝不遮盖 AppBar */
  @media (max-width: 1023px) {
    .tool-sidebar {
      position: fixed; top: 56px; bottom: 0; left: 0; z-index: 20;
      width: 280px;
      visibility: visible;
      transform: translateX(-100%);
      transition: transform .2s ease;
    }
    :global(html[data-sidebar='open']) .tool-sidebar {
      transform: translateX(0);
    }
    :global(html[data-sidebar='open']) .sidebar-scrim { display: block; }
  }
</style>

<script>
  const KEY = 'eo_sidebar';
  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>('#sidebar-toggle');
  const scrim = document.querySelector<HTMLElement>('#sidebar-scrim');
  const sidebar = document.querySelector<HTMLElement>('#tool-sidebar');

  const isOpen = () => root.getAttribute('data-sidebar') === 'open';
  const setOpen = (open: boolean) => {
    root.setAttribute('data-sidebar', open ? 'open' : 'closed');
    localStorage.setItem(KEY, open ? '1' : '0');
    toggle?.setAttribute('aria-expanded', String(open));
  };

  toggle?.setAttribute('aria-expanded', String(isOpen()));
  toggle?.addEventListener('click', () => setOpen(!isOpen()));
  scrim?.addEventListener('click', () => setOpen(false));
  sidebar?.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', () => {
      if (matchMedia('(max-width: 1023px)').matches) setOpen(false);
    });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen() && !(e.target instanceof HTMLInputElement)) setOpen(false);
  });
</script>
