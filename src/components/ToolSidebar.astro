---
import { tools } from '../tools/registry.js';
import { withBase } from '../lib/paths.js';

interface Props {
  current: string;
}

const { current } = Astro.props;

const groups = new Map<string, typeof tools>();
for (const t of tools) {
  const key = t.category || '其他';
  const list = groups.get(key);
  if (list) list.push(t);
  else groups.set(key, [t]);
}

const isHome = current === '/tools/' || current === '/tools';
---

<div class="sidebar-scrim" id="sidebar-scrim" aria-hidden="true"></div>
<aside class="tool-sidebar" id="tool-sidebar" aria-label="工具导航">
  <a href={withBase('/tools/')} class="ts-brand">
    <span class="ts-brand-name">Earth Online</span>
    <span class="ts-brand-sub">人生面板 · 在线工具</span>
  </a>

  <nav class="ts-nav">
    <a
      href={withBase('/tools/')}
      class:list={['ts-item', { active: isHome }]}
      aria-current={isHome ? 'page' : undefined}
    >
      <span class="mi" aria-hidden="true">home</span>
      全部工具
    </a>

    {[...groups.entries()].map(([name, list]) => (
      <div class="ts-group">
        <div class="ts-group-title">{name}</div>
        {list.map((t) => {
          const href = `/tools/${t.slug}/`;
          const active = current === href;
          return (
            <a
              href={withBase(href)}
              class:list={['ts-item', { active }]}
              aria-current={active ? 'page' : undefined}
            >
              {t.icon && <span class="mi" aria-hidden="true">{t.icon}</span>}
              {t.title}
            </a>
          );
        })}
      </div>
    ))}
  </nav>
</aside>

<style>
  .app-col { transition: margin-left .2s ease; }

  .sidebar-scrim {
    display: none;
    position: fixed; inset: 0;
    background: rgba(0, 0, 0, .45);
    z-index: 15;
  }

  /* 全高左轨道：从视口顶到底，桌面推挤右栏，窄屏 overlay 抽屉 */
  .tool-sidebar {
    position: fixed; top: 0; bottom: 0; left: 0;
    width: 280px; z-index: 20;
    background: var(--surface-container-low);
    display: flex; flex-direction: column;
    transform: translateX(-100%);
    visibility: hidden;
    transition: transform .2s ease, visibility .2s ease;
  }
  :global(html[data-sidebar='open']) .tool-sidebar {
    transform: translateX(0);
    visibility: visible;
  }

  /* 品牌色块（fnos：纯色阶，无描边无渐变） */
  .ts-brand {
    display: flex; flex-direction: column; gap: 4px;
    padding: 26px 22px 22px;
    background: var(--primary);
    color: var(--on-primary);
  }
  .ts-brand:hover { text-decoration: none; }
  .ts-brand-name { font-family: var(--font-title); font-size: 22px; font-weight: 800; letter-spacing: .5px; }
  .ts-brand-sub { font-size: 12.5px; opacity: .85; }

  .ts-nav { flex: 1; overflow-y: auto; padding: 12px 10px 24px; display: flex; flex-direction: column; gap: 4px; }
  .ts-item {
    display: flex; align-items: center; gap: 12px;
    padding: 10px 14px; border-radius: var(--radius-lg);
    color: var(--on-surface-variant);
    font-size: 14px; font-weight: 500;
  }
  .ts-item:hover { text-decoration: none; color: var(--primary); }
  .ts-item .mi { font-size: 20px; }
  .ts-item.active {
    background: var(--surface-container-high);
    color: var(--on-surface); font-weight: 600;
  }

  .ts-group { display: flex; flex-direction: column; gap: 2px; margin-top: 8px; }
  .ts-group-title {
    padding: 14px 14px 6px;
    font-size: 12px; font-weight: 600;
    color: var(--on-surface-variant);
    letter-spacing: .5px;
  }

  @media (min-width: 1024px) {
    :global(html[data-sidebar='open']) .app-col { margin-left: 280px; }
  }

  @media (max-width: 1023px) {
    :global(html[data-sidebar='open']) .sidebar-scrim { display: block; }
  }
</style>

<script>
  const KEY = 'eo_sidebar';
  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>('#sidebar-toggle');
  const scrim = document.querySelector<HTMLElement>('#sidebar-scrim');
  const sidebar = document.querySelector<HTMLElement>('#tool-sidebar');

  const isOpen = () => root.getAttribute('data-sidebar') === 'open';
  const setOpen = (open: boolean) => {
    root.setAttribute('data-sidebar', open ? 'open' : 'closed');
    localStorage.setItem(KEY, open ? '1' : '0');
    toggle?.setAttribute('aria-expanded', String(open));
  };

  toggle?.setAttribute('aria-expanded', String(isOpen()));
  toggle?.addEventListener('click', () => setOpen(!isOpen()));
  scrim?.addEventListener('click', () => setOpen(false));
  sidebar?.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', () => {
      if (matchMedia('(max-width: 1023px)').matches) setOpen(false);
    });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen() && !(e.target instanceof HTMLInputElement)) setOpen(false);
  });
</script>
