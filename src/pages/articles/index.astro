---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../../lib/paths.js';

const articles = (await getCollection('articles')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---
<Base title="文章" description="Earth Online 知识博客：把人生、数据与工具背后的原理讲清楚。">
  <h1 class="page-title">文章</h1>
  <p class="page-sub">把人生、数据与工具背后的原理讲清楚</p>

  <div class="post-list">
    {articles.map((a) => (
      <div class="post-preview">
        {/* DOM 顺序：元信息 → 配图 → 描述；窄屏自然堆叠为上中下，宽屏用 order 排为左中右（对标 distill.pub） */}
        <div class="post-meta">
          <time datetime={a.data.date.toISOString().slice(0, 10)}>
            {a.data.date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'short' })}
          </time>
          <div class="post-tags">
            {a.data.tags.map((t) => <span class="tag">{t}</span>)}
          </div>
        </div>

        <a class="post-thumb" href={withBase(`/articles/${a.id}/`)} aria-label={a.data.title}>
          {a.data.image ? (
            <img src={withBase(a.data.image)} alt="" loading="lazy" />
          ) : (
            <span class="post-thumb-placeholder">
              <span class="mi" aria-hidden="true">article</span>
            </span>
          )}
        </a>

        <a class="post-desc" href={withBase(`/articles/${a.id}/`)}>
          <h2>{a.data.title}</h2>
          <p>{a.data.description}</p>
        </a>
      </div>
    ))}
    {articles.length === 0 && <p class="post-empty">还没有文章。</p>}
  </div>
</Base>

<style>
  .post-list { max-width: 1000px; }

  /* fnos：条目无边框无底色无分隔线，靠大间距分隔（决策 #13） */
  .post-preview {
    display: flex; flex-direction: column; gap: 14px;
    padding: 8px 0 40px;
  }

  .post-meta {
    display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
    font-size: 13px; color: var(--on-surface-variant);
  }
  .post-tags { display: flex; gap: 8px; flex-wrap: wrap; }
  .tag {
    padding: 2px 10px; border-radius: 999px;
    background: var(--primary-container); color: var(--on-primary-container);
    font-size: 12px;
  }

  .post-thumb {
    display: block; border-radius: var(--radius-lg); overflow: hidden;
    background: var(--surface-container-low);
  }
  .post-thumb img {
    display: block; width: 100%; height: 100%;
    aspect-ratio: 16 / 9; object-fit: cover;
  }
  .post-thumb-placeholder {
    display: flex; align-items: center; justify-content: center;
    aspect-ratio: 16 / 9; width: 100%;
    background: var(--primary-container); color: var(--on-primary-container);
  }
  .post-thumb-placeholder .mi { font-size: 44px; opacity: .55; }

  .post-desc h2 {
    font-size: 23px; font-weight: 800; line-height: 1.35;
    font-family: var(--font-title); color: var(--on-surface);
    margin-bottom: 8px;
  }
  .post-desc p { font-size: 14.5px; line-height: 1.7; color: var(--on-surface-variant); }
  .post-desc:hover { text-decoration: none; }
  .post-desc:hover h2 { color: var(--primary); }
  .post-empty { text-align: center; color: var(--on-surface-variant); padding: 48px 0; }

  /* 宽容器（右栏 ≥768px）：左中右三栏——元信息 140px ｜ 描述自适应 ｜ 配图 340px。
     用容器查询而非媒体查询：侧栏展开占 280px，断点必须按右栏真实宽度判断 */
  @container (min-width: 768px) {
    .post-preview {
      flex-direction: row; align-items: flex-start;
      gap: 28px;
    }
    .post-meta {
      order: 1; width: 140px; flex-shrink: 0;
      flex-direction: column; align-items: flex-start; gap: 10px;
      padding-top: 6px;
    }
    .post-desc { order: 2; flex: 1; min-width: 0; }
    .post-thumb {
      order: 3; width: 340px; flex-shrink: 0;
      transition: box-shadow .15s ease;
    }
    .post-thumb:hover { box-shadow: 0 4px 16px rgba(0, 137, 123, .12); }
  }
</style>
