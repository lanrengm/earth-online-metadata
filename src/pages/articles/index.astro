---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../../lib/paths.js';

const articles = (await getCollection('articles')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---
<Base title="文章" description="Earth Online 知识博客：把人生、数据与工具背后的原理讲清楚。">
  <h1 class="page-title">文章</h1>
  <p class="page-sub">把人生、数据与工具背后的原理讲清楚</p>

  <div class="article-list">
    {articles.map((a) => (
      <a class="app-card article-card" href={withBase(`/articles/${a.id}/`)}>
        <h2>{a.data.title}</h2>
        <p>{a.data.description}</p>
        <div class="article-meta">
          <time datetime={a.data.date.toISOString().slice(0, 10)}>
            {a.data.date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
          {a.data.tags.map((t) => <span class="tag">{t}</span>)}
        </div>
      </a>
    ))}
    {articles.length === 0 && <p class="article-empty">还没有文章。</p>}
  </div>
</Base>

<style>
  .article-list { display: flex; flex-direction: column; gap: 16px; max-width: 780px; }
  .article-card { display: block; padding: 20px 24px; transition: border-color .15s ease, box-shadow .15s ease; }
  .article-card:hover { text-decoration: none; border-color: var(--primary); box-shadow: 0 4px 16px rgba(0, 137, 123, .12); }
  .article-card h2 { font-size: 19px; font-weight: 700; margin-bottom: 8px; }
  .article-card p { font-size: 14px; color: var(--on-surface-variant); line-height: 1.6; margin-bottom: 12px; }
  .article-meta { display: flex; align-items: center; gap: 12px; font-size: 13px; color: var(--on-surface-variant); }
  .tag {
    padding: 2px 10px; border-radius: 999px;
    background: var(--primary-container); color: var(--on-primary-container);
    font-size: 12px;
  }
  .article-empty { text-align: center; color: var(--on-surface-variant); padding: 48px 0; }
</style>
