---
import Base from '../../layouts/Base.astro';
import SpatialMemoryTest from '../../components/tests/SpatialMemoryTest.jsx';
---
<Base title="空间记忆" description="3×3 网格中色块按序闪现，凭记忆复现位置与顺序：Corsi 经典范式，测空间工作记忆。本机计算，零隐私收集。">
  <h1 class="page-title">空间记忆</h1>
  <p class="page-sub">记住色块闪现的位置和顺序 · 每个长度可错 1 次</p>
  <SpatialMemoryTest client:load />
</Base>

<style is:global>
  .sm { display: flex; flex-direction: column; gap: 16px; max-width: 560px; }
  .sm-status {
    min-height: 28px; font-size: 15px; font-weight: 600;
    color: var(--on-surface-variant); text-align: center;
  }
  .sm-grid {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px;
    max-width: 360px; margin: 0 auto; width: 100%;
    background: var(--surface-container-low); border-radius: var(--radius-lg);
    padding: 14px; cursor: pointer;
  }
  .sm-cell {
    aspect-ratio: 1; border: none; border-radius: var(--radius-md);
    background: var(--surface-container-high); color: var(--on-primary);
    font-size: 22px; font-weight: 800; font-family: var(--font-title);
    cursor: pointer;
    transition: background-color .1s ease, color .1s ease;
  }
  .sm-cell:disabled { cursor: default; }
  .sm-cell.is-flash { background: var(--primary); }
  .sm-cell.is-picked { background: var(--primary-container); color: var(--on-primary-container); }
  .ds-progress { font-size: 13px; color: var(--on-surface-variant); }
</style>
