---
import Base from '../../layouts/Base.astro';
import TimePerceptionTest from '../../components/tests/TimePerceptionTest.jsx';
---
<Base title="时间感知" description="不看钟，凭内部感觉估出 5/8/12 秒后停止：测内部时钟精度。本机计算，零隐私收集。">
  <h1 class="page-title">时间感知</h1>
  <p class="page-sub">不看钟，凭感觉估出目标时长 · 5 轮取误差中位数</p>
  <TimePerceptionTest client:load />
</Base>

<style is:global>
  .tp { display: flex; flex-direction: column; gap: 16px; max-width: 560px; }
  .tp-status {
    min-height: 28px; font-size: 15px; font-weight: 600;
    color: var(--on-surface-variant); text-align: center;
  }
  .tp-pad {
    height: 260px; border: none; border-radius: var(--radius-lg);
    background: var(--surface-container-low); color: var(--on-surface);
    font-size: 20px; font-weight: 700; font-family: var(--font-title);
    line-height: 1.6; cursor: pointer;
    transition: background-color .15s ease;
    user-select: none; -webkit-user-select: none; touch-action: manipulation;
  }
  .tp-pad small { font-size: 13px; font-weight: 400; color: var(--on-surface-variant); font-family: var(--font-body); }
  .tp-pad.is-running { background: var(--surface-container-high); color: var(--on-surface-variant); }
  .tp-feedback { font-size: 18px; }
</style>
