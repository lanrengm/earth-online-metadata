---
import Base from '../../layouts/Base.astro';
import AuditoryReactionTest from '../../components/tests/AuditoryReactionTest.jsx';
import { isLive } from '../../lib/visibility.js';
import { tests } from '../../tests/registry.js';
import { withBase } from '../../lib/paths.js';

/* Draft 守卫（决策 #18）：生产注册表查无此条目（draft 已滤除）时重定向回板块首页 */
if (!isLive(tests, 'auditory-reaction')) return Astro.redirect(withBase('/tests/'));
---
<Base title="听觉反应" description="听到提示音的瞬间点击：5 轮取中位数，测你的听觉简单反应时。本机计算，零隐私收集。">
  <h1 class="page-title">听觉反应</h1>
  <p class="page-sub">听到「哔」声的瞬间点击 · 5 轮取中位数 · 建议戴耳机</p>
  <AuditoryReactionTest client:load />
</Base>

<style is:global>
  .ar { display: flex; flex-direction: column; gap: 16px; max-width: 560px; }
  .ar-pad {
    height: 260px; border: none; border-radius: var(--radius-lg);
    background: var(--surface-container-low); color: var(--on-surface);
    font-size: 22px; font-weight: 700; font-family: var(--font-title);
    line-height: 1.5; cursor: pointer;
    transition: background-color .08s ease, color .08s ease;
    user-select: none; -webkit-user-select: none; touch-action: manipulation;
  }
  .ar-pad small { font-size: 13px; font-weight: 400; color: var(--on-surface-variant); font-family: var(--font-body); }
  .ar-pad.is-waiting { background: var(--surface-container-high); color: var(--on-surface-variant); }
  .ar-pad.is-go { background: var(--primary); color: var(--on-primary); }
  .ar-error { font-size: 13.5px; color: var(--error); }
</style>
