---
import Base from '../../layouts/Base.astro';
import RiskPreferenceTest from '../../components/tests/RiskPreferenceTest.jsx';
import { isLive } from '../../lib/visibility.js';
import { tests } from '../../tests/registry.js';
import { withBase } from '../../lib/paths.js';

/* Draft 守卫（决策 #18）：生产注册表查无此条目（draft 已滤除）时重定向回板块首页 */
if (!isLive(tests, 'risk-preference')) return Astro.redirect(withBase('/tests/'));
---
<Base title="风险偏好" description="确定的小奖还是五五开的大奖：六道阶梯式二选一，画出你的风险容忍画像。本机计算，零隐私收集。">
  <h1 class="page-title">风险偏好</h1>
  <p class="page-sub">确定的小奖 vs 五五开的大奖 · 6 题阶梯递进 · 无对错</p>
  <RiskPreferenceTest client:load />
</Base>

<style is:global>
  .rp { display: flex; flex-direction: column; gap: 16px; max-width: 560px; }
  .rp-status {
    min-height: 28px; font-size: 15px; font-weight: 600;
    color: var(--on-surface-variant); text-align: center;
  }
  .rp-stage {
    min-height: 240px; border: none; border-radius: var(--radius-lg);
    background: var(--surface-container-low); color: var(--on-surface);
    font-family: var(--font-title); cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    padding: 24px; user-select: none; -webkit-user-select: none;
  }
  .rp-q { font-size: 22px; font-weight: 800; line-height: 1.6; }
  .rp-q small { font-size: 14px; font-weight: 400; color: var(--on-surface-variant); font-family: var(--font-body); }
  .rp-question { font-size: 15px; font-weight: 600; color: var(--on-surface-variant); margin-bottom: 16px; }
  .rp-options { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .rp-opt {
    border: none; border-radius: var(--radius-lg);
    background: var(--surface-container-high); color: var(--on-surface);
    padding: 22px 16px; cursor: pointer; font-family: var(--font-title);
    display: flex; flex-direction: column; gap: 6px; align-items: center;
    transition: filter .12s ease;
  }
  .rp-opt:hover { filter: brightness(1.06); }
  .rp-opt strong { font-size: 19px; }
  .rp-opt small { font-size: 12.5px; color: var(--on-surface-variant); font-family: var(--font-body); }
</style>
