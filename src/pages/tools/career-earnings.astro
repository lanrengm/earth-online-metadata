---
import Base from '../../layouts/Base.astro';
import EarningsCalculator from '../../components/tools/EarningsCalculator.jsx';
import { isLive } from '../../lib/visibility.js';
import { tools } from '../../tools/registry.js';
import { withBase } from '../../lib/paths.js';

/* Draft 守卫（决策 #18）：生产注册表查无此条目（draft 已滤除）时重定向回板块首页 */
if (!isLive(tools, 'career-earnings')) return Astro.redirect(withBase('/tools/'));
---
<Base
  title="生涯收入"
  description="输入年龄与月薪，计算到退休还能赚多少钱。纯本地计算，零隐私收集。"
>
  <h1 class="page-title">生涯收入</h1>
  <p class="page-sub">输入年龄与月薪，算算到退休还能进账多少</p>
  <EarningsCalculator client:load />
</Base>

<style is:global>
  /* 生涯收入计算器（React 岛屿样式，宿主页全局作用域；fnos：填充式输入、卡片无边框） */
  .ce { display: flex; flex-direction: column; gap: 24px; max-width: 560px; }

  .ce-form { display: flex; flex-direction: column; gap: 16px; }
  .ce-field { display: flex; flex-direction: column; gap: 6px; }
  .ce-label { font-size: 14px; font-weight: 600; color: var(--on-surface); }
  .ce-input {
    width: 100%; height: 48px; padding: 0 16px;
    border: 2px solid transparent; border-radius: var(--radius-lg);
    background: var(--surface-container-high); color: var(--on-surface);
    font-size: 16px; font-family: var(--font-body);
    font-variant-numeric: tabular-nums;
    outline: none; transition: border-color .15s ease;
  }
  .ce-input:focus { border-color: var(--primary); }
  .ce-hint { font-size: 12.5px; color: var(--on-surface-variant); }

  .ce-result {
    background: var(--surface-container-low);
    border-radius: var(--radius-lg);
    padding: 24px;
  }
  .ce-result-label { font-size: 14px; color: var(--on-surface-variant); margin-bottom: 8px; }
  .ce-total {
    font-family: var(--font-title);
    font-size: 40px; font-weight: 800; line-height: 1.2;
    color: var(--primary);
    font-variant-numeric: tabular-nums;
    margin-bottom: 10px;
    word-break: break-all;
  }
  .ce-unit { font-size: 18px; font-weight: 600; margin-left: 6px; }
  .ce-breakdown { font-size: 14px; color: var(--on-surface-variant); line-height: 1.7; }
  .ce-breakdown strong { color: var(--on-surface); }

  .ce-reset {
    align-self: flex-start;
    border: none; border-radius: var(--radius-lg);
    background: var(--surface-container-high); color: var(--primary);
    padding: 10px 20px; font-size: 14px; font-weight: 600;
    cursor: pointer; font-family: var(--font-body);
    transition: filter .15s ease;
  }
  .ce-reset:hover { filter: brightness(1.05); }
</style>
